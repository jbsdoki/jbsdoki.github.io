{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% assign lang = site.lang | split: '-' | first %}

{% case lang %}
  {% when 'pt' %}
    {% assign lang = site.lang %}

  {% when 'zh' %}
    {% assign lang_last = site.lang | split: '-' | last %}
    {% case lang_last %}
      {% when 'cn', 'sg', 'my', 'hans' %}
        {% assign lang = 'cn' %}
      {% when 'tw', 'hk', 'mo', 'hant' %}
        {% assign lang = 'zh-tw' %}
    {% endcase %}

    {% comment %} Add a new language using when... if needed {% endcomment %}
    {% comment %} If you still encounter language-display issues, check the available locale codes in github-readme-stats (different from ISO-639 standard used in your website) {% endcomment %}
    {% comment %} https://github.com/anuraghazra/github-readme-stats?tab=readme-ov-file#available-locales {% endcomment %}
{% endcase %}

{% if site.data.repositories.repo_description_lines_max %}
  {% assign max_lines = site.data.repositories.repo_description_lines_max %}
{% else %}
  {% assign max_lines = 2 %}
{% endif %}

{% capture github_repo_url %}https://github.com/{{ include.repository }}{% endcapture %}
{% assign has_org_text = false %}
{% if include.organization_summary %}
  {% assign has_org_text = true %}
{% endif %}
{% if include.contribution_summary %}
  {% assign has_org_text = true %}
{% endif %}

<div class="repo p-2">
  {% if has_org_text %}
    <div class="row align-items-start organization-repo-row">
      <div class="col-12 col-md-8 pr-md-3">
        {% if include.organization_summary %}
          <p class="text-start mb-3 organization-repo-desc">{{ include.organization_summary }}</p>
        {% endif %}
        {% if include.contribution_summary %}
          <p class="text-start mb-0 organization-repo-desc">{{ include.contribution_summary }}</p>
        {% endif %}
      </div>
      <div class="col-12 col-md-4 d-flex justify-content-center justify-content-md-end pl-md-2">
        <div class="text-center organization-repo-visual w-100 mx-auto" style="max-width: 420px">
          <a
            href="{{ github_repo_url }}"
            class="d-block text-decoration-none repo-card-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View {{ include.repository }} on GitHub"
          >
            {% if include.logo %}
              <div class="mb-3 d-flex justify-content-center align-items-center organization-repo-logo-wrap">
                <img
                  src="{{ include.logo | relative_url }}"
                  alt=""
                  class="img-fluid organization-repo-logo-img"
                  width="280"
                  height="120"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                >
              </div>
            {% endif %}
            <img
              class="only-light w-100 rounded"
              alt=""
              aria-hidden="true"
              src="{{ site.external_services.github_readme_stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_light }}&locale={{ lang }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
            >
            <img
              class="only-dark w-100 rounded"
              alt=""
              aria-hidden="true"
              src="{{ site.external_services.github_readme_stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_dark }}&locale={{ lang }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
            >
          </a>
          <p class="repo-github-label-wrap mb-0 mt-3">
            <a
              href="{{ github_repo_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="repo-github-label text-decoration-none"
            >
              <i class="fa-brands fa-github" aria-hidden="true"></i>
              <span class="ml-1">{{ include.repository }}</span>
            </a>
          </p>
        </div>
      </div>
    </div>
  {% else %}
    <div class="text-center">
      <a
        href="{{ github_repo_url }}"
        class="d-block text-decoration-none repo-card-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View {{ include.repository }} on GitHub"
      >
        {% if include.logo %}
          <div class="mb-3 d-flex justify-content-center align-items-center organization-repo-logo-wrap">
            <img
              src="{{ include.logo | relative_url }}"
              alt=""
              class="img-fluid organization-repo-logo-img"
              width="280"
              height="120"
              loading="lazy"
              decoding="async"
              aria-hidden="true"
            >
          </div>
        {% endif %}
        <img
          class="only-light w-100"
          alt=""
          aria-hidden="true"
          src="{{ site.external_services.github_readme_stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_light }}&locale={{ lang }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
        >
        <img
          class="only-dark w-100"
          alt=""
          aria-hidden="true"
          src="{{ site.external_services.github_readme_stats_url }}/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_dark }}&locale={{ lang }}&show_owner={{ show_owner }}&description_lines_count={{ max_lines }}"
        >
      </a>
      <p class="repo-github-label-wrap mb-0 mt-3">
        <a
          href="{{ github_repo_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="repo-github-label text-decoration-none"
        >
          <i class="fa-brands fa-github" aria-hidden="true"></i>
          <span class="ml-1">{{ include.repository }}</span>
        </a>
      </p>
    </div>
  {% endif %}
</div>
