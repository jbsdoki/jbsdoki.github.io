---
layout: default
---
<div class="about-page">
  <section class="about-hero" aria-label="Introduction">
    <div class="about-hero__atmosphere" aria-hidden="true">
      <div class="about-hero__glow about-hero__glow--one"></div>
      <div class="about-hero__glow about-hero__glow--two"></div>
      <img
        class="about-hero__mesh"
        src="{{ '/assets/img/hero-mesh.svg' | relative_url }}"
        alt=""
        width="1200"
        height="800"
        decoding="async"
      >
    </div>

    <div class="about-hero__inner">
      <div class="about-hero__copy">
        <h1 class="about-hero__name">
          {% if site.title == 'blank' %}
            <span class="about-hero__firstname">{{ site.first_name }}</span>
            {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h1>

        {% if page.subtitle %}
          <p class="about-hero__subtitle">{{ page.subtitle }}</p>
        {% endif %}

        {% if page.profile and page.profile.more_info %}
          <div class="about-hero__meta">{{ page.profile.more_info }}</div>
        {% endif %}

        <div class="about-hero__ctas">
          {% if site.data.socials.cv_pdf %}
            <a
              class="about-hero__cta about-hero__cta--primary"
              href="{{ site.data.socials.cv_pdf | relative_url }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
              View CV
            </a>
          {% endif %}
          {% if site.data.socials.github_username %}
            <a
              class="about-hero__cta about-hero__cta--ghost"
              href="https://github.com/{{ site.data.socials.github_username }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-github" aria-hidden="true"></i>
              GitHub
            </a>
          {% endif %}
          {% if site.data.socials.linkedin_username %}
            <a
              class="about-hero__cta about-hero__cta--ghost"
              href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
              LinkedIn
            </a>
          {% endif %}
        </div>
      </div>

      {% if page.profile and page.profile.image %}
        <div class="about-hero__photo">
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_class = 'img-fluid' %}
          {% capture sizes %}(min-width: {{ site.max_width }}) 320px, (min-width: 768px) 30vw, 80vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        </div>
      {% endif %}
    </div>
  </section>

  <article class="about-body">
    <div class="about-bio clearfix">{{ content }}</div>

    <section class="about-focus" aria-labelledby="about-focus-title">
      <h2 id="about-focus-title" class="about-focus__title">Focus</h2>
      <ul class="about-focus__list">
        <li class="about-focus__item">
          <i class="fa-solid fa-robot about-focus__icon" aria-hidden="true"></i>
          AI Agents
        </li>
        <li class="about-focus__item">
          <i class="fa-solid fa-brain about-focus__icon" aria-hidden="true"></i>
          Machine Learning
        </li>
        <li class="about-focus__item">
          <i class="fa-solid fa-server about-focus__icon" aria-hidden="true"></i>
          Systems
        </li>
        <li class="about-focus__item">
          <i class="fa-solid fa-shield-halved about-focus__icon" aria-hidden="true"></i>
          Security
        </li>
      </ul>
    </section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
